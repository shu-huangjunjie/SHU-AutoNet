{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHU AutoNet",
  "version": "1.0.2",
  "identifier": "com.shu.autonet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:21420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SHU AutoNet",
        "width": 520,
        "height": 760,
        "minWidth": 480,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "shu-huangjunjie",
    "homepage": "https://github.com/shu-huangjunjie/SHU-AutoNet",
    "resources": { "installed.flag": "installed.flag" },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
